#!/usr/bin/env bash
# The owner's host worker. It takes only the queue of tasks that run on a plan (PLAN_QUEUE in
# settings), because the Claude Code and Codex CLIs are signed in on this machine and not in
# the worker container. Everything else stays with the container worker.
#
# Usage: ./plan-worker            (stop with Ctrl-C; start it again after changing src/)
set -euo pipefail
cd "$(dirname "$0")"

# The stack's own .env, read as Compose reads it: KEY=VALUE lines, nothing evaluated.
while IFS= read -r line || [ -n "$line" ]; do
  [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
  key="${BASH_REMATCH[1]}"
  value="${BASH_REMATCH[2]}"
  # a value wrapped in one pair of quotes loses them, as in Compose
  case "$value" in
    \"*\") value="${value#\"}"; value="${value%\"}" ;;
    \'*\') value="${value#\'}"; value="${value%\'}" ;;
  esac
  export "$key=$value"
done < .env

# The stack's database and broker as the host reaches them, not by their container names.
export DATABASE_URL="postgresql://almonium_books:almonium_books@localhost:5433/almonium_books"
export CELERY_BROKER_URL="amqp://almonium_books:almonium_books@localhost:5673/almonium_books"

exec .venv/bin/python -m celery -A almonium_book_processor.config worker \
  --queues plans --hostname "plans@%h" --loglevel INFO \
  --concurrency "${PLAN_WORKER_CONCURRENCY:-2}"
