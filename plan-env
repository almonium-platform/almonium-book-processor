# Sourced by ./plan-worker and ./plan-manage: the environment of a process that runs on the
# owner's host, beside the stack, where the Claude Code and Codex CLIs are signed in.
#
# Never run docker compose from a shell that sourced this: Compose would hand the containers
# the host's database and broker addresses below, and they would not start.

cd "$(dirname "${BASH_SOURCE[0]}")"

# The stack's own .env, read as Compose reads it: KEY=VALUE lines, nothing evaluated.
while IFS= read -r line || [ -n "$line" ]; do
  [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
  key="${BASH_REMATCH[1]}"
  value="${BASH_REMATCH[2]}"
  # a value wrapped in one pair of quotes loses them, as in Compose
  case "$value" in
    \"*\") value="${value#\"}"; value="${value%\"}" ;;
    \'*\') value="${value#\'}"; value="${value%\'}" ;;
  esac
  export "$key=$value"
done < .env

# The stack's database and broker as the host reaches them, not by their container names.
export DATABASE_URL="postgresql://almonium_books:almonium_books@localhost:5433/almonium_books"
export CELERY_BROKER_URL="amqp://almonium_books:almonium_books@localhost:5673/almonium_books"
