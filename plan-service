#!/usr/bin/env bash
# ./plan-worker as a systemd user service, one per pair of plan accounts, so the host workers
# start with the machine, come back after a crash and do not die with the terminal that
# started them.
#
# A worker is named and given its accounts once, at install: the directory that holds a Codex
# login (~/.codex is the CLI's default; a second account is logged in with
# CODEX_HOME=~/.codex-2 codex login) and the one that holds a Claude Code login (~/.claude;
# a second with CLAUDE_CONFIG_DIR=~/.claude-2 claude login). The accounts are kept in
# ~/.config/almonium/plan-worker-<name>.env and the service is almonium-plan-worker@<name>.
#
# Usage: ./plan-service install <name> [codex home] [claude config dir]
#        ./plan-service restart [name]      after changing src/; every worker when unnamed
#        ./plan-service status | logs <name> [lines] | uninstall <name>
#
# The unit is written for this checkout and with this shell's PATH, which is where the worker
# finds the claude and codex CLIs: install it from a shell in which both run.
set -euo pipefail

template=almonium-plan-worker@.service
repo="$(cd "$(dirname "$0")" && pwd)"
config="${XDG_CONFIG_HOME:-$HOME/.config}"
file="$config/systemd/user/$template"
name="${2:-}"
unit="almonium-plan-worker@$name.service"

units() {
  systemctl --user list-units --all --plain --no-legend 'almonium-plan-worker@*' | awk '{print $1}'
}

case "${1:-}" in
  install)
    [ -n "$name" ] || { echo "name the worker: ./plan-service install main"; exit 2; }
    mkdir -p "$(dirname "$file")" "$config/almonium"
    {
      echo "PLAN_WORKER_NAME=$name"
      [ -z "${3:-}" ] || echo "CODEX_HOME=$3"
      [ -z "${4:-}" ] || echo "CLAUDE_CONFIG_DIR=$4"
    } > "$config/almonium/plan-worker-$name.env"
    cat > "$file" <<UNIT
[Unit]
Description=Almonium book processor: worker %i for the jobs that run on the owner's plans

[Service]
WorkingDirectory=$repo
Environment=PATH=$PATH
EnvironmentFile=%h/.config/almonium/plan-worker-%i.env
ExecStart=$repo/plan-worker
# the stack's broker may not be up yet at boot; a crashed worker leaves jobs waiting
Restart=always
RestartSec=15
# a restart does not wait for a long job: one cut off here goes back to the queue, and its run
# may need retrying from the edition page. Restart when no plan job is running.
TimeoutStopSec=30

[Install]
WantedBy=default.target
UNIT
    # every quarter of an hour the host records each account's meter for the pages
    cat > "$config/systemd/user/almonium-plan-meter.service" <<UNIT
[Unit]
Description=Almonium book processor: record the plan accounts' meters

[Service]
Type=oneshot
WorkingDirectory=$repo
Environment=PATH=$PATH
ExecStart=$repo/plan-manage plan_meter --record
UNIT
    cat > "$config/systemd/user/almonium-plan-meter.timer" <<UNIT
[Unit]
Description=Almonium book processor: record the plan accounts' meters every 15 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=15min

[Install]
WantedBy=timers.target
UNIT
    # every quarter of an hour the factory reports its books to Almonium and starts the next
    # wanted one if the plans have room (FACTORY_ENABLED in .env; off, the tick only reports)
    cat > "$config/systemd/user/almonium-factory.service" <<UNIT
[Unit]
Description=Almonium book processor: one pass of the factory
After=almonium-plan-meter.service

[Service]
Type=oneshot
WorkingDirectory=$repo
Environment=PATH=$PATH
ExecStart=$repo/plan-manage factory_tick
UNIT
    cat > "$config/systemd/user/almonium-factory.timer" <<UNIT
[Unit]
Description=Almonium book processor: run the factory every 15 minutes

[Timer]
OnBootSec=4min
OnUnitActiveSec=15min

[Install]
WantedBy=timers.target
UNIT
    systemctl --user daemon-reload
    systemctl --user enable --now "$unit" almonium-plan-meter.timer almonium-factory.timer
    # without lingering, a user's services start at login and stop at logout
    loginctl show-user "$USER" -p Linger | grep -q "=yes" ||
      echo "Starts at login. To start it at boot: sudo loginctl enable-linger $USER"
    systemctl --user --no-pager status "$unit" | head -5
    ;;
  uninstall)
    [ -n "$name" ] || { echo "name the worker to remove"; exit 2; }
    systemctl --user disable --now "$unit" || true
    rm -f "$config/almonium/plan-worker-$name.env"
    if [ -z "$(units)" ]; then
      systemctl --user disable --now almonium-plan-meter.timer almonium-factory.timer || true
      rm -f "$file" "$config/systemd/user/almonium-plan-meter.service" \
        "$config/systemd/user/almonium-plan-meter.timer" \
        "$config/systemd/user/almonium-factory.service" "$config/systemd/user/almonium-factory.timer"
    fi
    systemctl --user daemon-reload
    ;;
  restart)
    if [ -n "$name" ]; then systemctl --user restart "$unit"; else
      for running in $(units); do systemctl --user restart "$running"; done
    fi
    ;;
  status) systemctl --user --no-pager status 'almonium-plan-worker@*' ;;
  logs) journalctl --user -u "$unit" -n "${3:-100}" --no-pager ;;
  *)
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
