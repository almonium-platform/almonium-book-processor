DEBUG=true
SECRET_KEY=local-development-only
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=postgresql://almonium_books:almonium_books@postgres:5432/almonium_books
CELERY_BROKER_URL=amqp://almonium_books:almonium_books@rabbitmq:5672/almonium_books
ALMONIUM_API_URL=http://host.docker.internal:9998/api/v1
ALMONIUM_BOOKS_PUBLISHER_TOKEN=replace-with-the-shared-local-publication-secret
# What this environment accepts from a source that promotes editions here.
ALMONIUM_BOOKS_PROMOTION_TOKEN=
# Where this environment may promote editions to, and each target's token;
# the same token lets `manage.py pull_edition_bundle` fetch from there.
ALMONIUM_BOOKS_PROMOTION_TARGETS=staging=https://staging.books.almonium.com
ALMONIUM_BOOKS_PROMOTION_TOKEN_STAGING=
NLP_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
OPENAI_API_KEY=
OPENAI_ALIGNMENT_PRIMARY_MODEL=gpt-5.6-luna
OPENAI_ALIGNMENT_ESCALATION_MODEL=gpt-5.6-terra
OPENAI_ALIGNMENT_CONFIDENCE=0.80
OPENAI_TRANSLATION_QUALITY_MODEL=gpt-5.6-terra
# Owner's machine only: write level adaptations on a plan instead of the API, as a seat
# provider:model[:effort]. Tasks that use it go to the "plans" queue, which only ./plan-worker
# takes, so start that worker when this is set. Leave empty anywhere else.
ADAPTATION_GENERATOR=
# Who writes the marginal notes, the same way. Empty is the API's quality model.
GLOSS_WRITER=
# Owner's machine only, same rule: the blind difficulty judges and the fidelity auditors of a
# chapter pilot or floor probe, as seats separated by commas. Each judge reads
# DIFFICULTY_READINGS times and its middle reading counts; two auditors check each other's
# material findings. Empty keeps the API's single judge and single auditor.
DIFFICULTY_JUDGES=
DIFFICULTY_READINGS=3
# Chapters the judges read at a time when they analyse an edition.
DIFFICULTY_JUDGE_WORKERS=1
# Chapters a book's adaptation writes at a time.
ADAPTATION_WRITE_WORKERS=3
# Windows of a translation its two editors read at a time, and how a production translates:
# codex, subscription (the Claude Code plan) or quality (the paid API).
TRANSLATION_REVIEW_WORKERS=1
PRODUCTION_TRANSLATION_TIER=codex
# The translation's two editors, as seats: one per vendor, never the model that translated.
# Empty is Opus and gpt-6-astra at medium effort.
TRANSLATION_REVIEWERS=
FIDELITY_AUDITORS=
# Chapters of an edition two auditors read at a time.
FIDELITY_AUDIT_WORKERS=1
# The Codex CLI ./plan-worker should run, when an older one is first on the path.
CODEX_BINARY=codex
OPENAI_TRANSLATION_DRAFT_MODEL=gpt-5.6-luna
OPENAI_METADATA_MODEL=gpt-5.6-luna
OPENAI_BATCH_POLL_SECONDS=60
